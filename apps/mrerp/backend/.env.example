MRERP_ENV=development
MRERP_MOCK_IDENTITY=true
MRERP_SECRET_KEY=replace-with-a-local-random-value
MRERP_ALLOWED_HOSTS=localhost,127.0.0.1
MRERP_CSRF_TRUSTED_ORIGINS=http://localhost:4173
MRERP_DB_ENGINE=postgres
POSTGRES_DB=mrerp
POSTGRES_USER=mrerp
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
MRERP_REDIS_URL=redis://127.0.0.1:6379/0
MRERP_MEDIA_ROOT=./media
